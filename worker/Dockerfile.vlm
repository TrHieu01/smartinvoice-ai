# Experimental GPU worker; deploy only after a separate credit budget is approved.
FROM python:3.11-slim
COPY --from=ghcr.io/astral-sh/uv:0.9.26 /uv /usr/local/bin/uv
RUN apt-get update && apt-get install -y --no-install-recommends libglib2.0-0 libgomp1 libgl1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_PROJECT_ENVIRONMENT=/opt/venv PATH="/opt/venv/bin:$PATH" OCR_DEVICE=cpu PADDLE_PDX_CACHE_HOME=/opt/models PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True HF_HOME=/tmp/huggingface HF_HUB_DISABLE_XET=1 EXTRACTION_BACKEND=qwen_vl
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --extra worker --extra vision --no-cache
COPY backend ./backend
COPY worker ./worker
# Bake both OCR and pinned VLM weights into the image, with no runtime model download.
RUN python -c "from worker.pipeline import paddle_engine; paddle_engine()"
RUN python -c "from transformers import Qwen3VLForConditionalGeneration; from huggingface_hub import snapshot_download; from worker.vision import MODEL_ID, MODEL_REVISION, MODEL_DIRECTORY; snapshot_download(MODEL_ID, revision=MODEL_REVISION, local_dir=MODEL_DIRECTORY, allow_patterns=['*.json','*.safetensors','*.txt','*.model','*.jinja'])"
RUN python -c "from transformers import AutoProcessor; from PIL import Image; p=AutoProcessor.from_pretrained('/opt/vlm', local_files_only=True, trust_remote_code=False); x=p.apply_chat_template([{'role':'user','content':[{'type':'image','image':Image.new('RGB',(56,56))},{'type':'text','text':'Extract receipt JSON.'}]}], tokenize=True, add_generation_prompt=True, return_dict=True, return_tensors='pt'); assert x['input_ids'].shape[1] > 0"
RUN useradd --create-home appuser && chown -R appuser:appuser /opt/models /app
USER appuser
CMD ["python", "-u", "-m", "worker.handler"]
